#!/usr/bin/env bash
# Data guard: raw and record-level data never enter git.
#   1. blocks staged paths under data/ and any .xlsx / .zip / .pdf
#   2. scans every staged .ipynb blob with scripts/check_notebook_outputs.py
# Activate once per clone (repo-level config, shared by every worktree):
#   git config core.hooksPath .githooks
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
bad=0
tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

while IFS= read -r -d '' path; do
  case "$path" in
    data/*|*.xlsx|*.zip|*.pdf)
      echo "pre-commit: blocked data path $path (data never enters git, see README)" >&2
      bad=1
      ;;
  esac
  case "$path" in
    *.ipynb)
      tmp="$tmpdir/nb.ipynb"
      git show ":$path" > "$tmp"
      if ! report="$(python3 -I "$root/scripts/check_notebook_outputs.py" "$tmp" 2>&1)"; then
        printf '%s\n' "$report" >&2
        echo "pre-commit: notebook $path has record-level looking outputs (see above)" >&2
        bad=1
      fi
      ;;
  esac
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

if [ "$bad" -ne 0 ]; then
  exit 1
fi
